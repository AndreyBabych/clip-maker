# Production: PostgreSQL + private S3-compatible bucket, web + worker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clipmaker
ADMIN_PASSWORD=
APP_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=development
TRUST_PROXY_HOPS=1
STORAGE_MODE=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FAL_KEY=
OPENAI_API_KEY=
# Choose a model accessible to your account with Chat Completions JSON mode.
OPENAI_MODEL=
PROVIDER_CONCURRENCY=2
# Optional verified estimates, NOT actual bills. Keys: flux-text, flux-reference,
# kling, seedance, screenplay. Each value: {"usd":number,"unit":"request"|"second"}.
# No prices are supplied or inferred. Unknown prices display Cost unavailable.
PROVIDER_ESTIMATES_JSON={}
# Optional external FFmpeg binary paths. Docker provides both automatically.
FFMPEG_PATH=
FFPROBE_PATH=
# For local development only, omit DATABASE_URL and use:
# LOCAL_DATA_DIR=.local
# STORAGE_MODE=local
