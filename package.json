{
  "name": "clip-maker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "worker": "node worker.js",
    "local": "node --env-file=.env.local server.js",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "setup:local": "node scripts/local-setup.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@electric-sql/pglite": "^0.5.15",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "file-type": "^22.3.0",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yazl": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "fast-xml-parser": "^5.12.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/win32-x64": "^4.1.0",
    "@ffprobe-installer/win32-x64": "^5.1.0"
  }
}
